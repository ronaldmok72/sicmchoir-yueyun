rules_version = '2';
// 乐韵 App 的资料库锁（第 4 步：收紧版＋打乱过的电话、密码藏起来）
// 贴到 Firebase → Firestore → 规则（Rules）→ 发布。这个文件只是留底，改了要再贴一次。
// 大家都看得到。改资料要通行证（App 登录／输过后台密码），而且：
//   后台的资料 → 要有那一区（密码管理开的区）；最高权限（access）什么都能改
//   团员 → 只能改自己的「会来／请假」、自己扫码签到、自己的资料
//   打乱过的电话、PIN、密码表藏在 secrets：谁都不能看、不能改（只有登录服务 /api/login 用服务器钥匙碰得到）
// 例外：没登录也可以交测验（新团员注册、设 PIN、换电话都经登录服务）
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function areas() { return signedIn() ? request.auth.token.get('areas', []) : []; }
    function can(list) { return areas().hasAny(list) || areas().hasAny(['access']); }
    function me() { return signedIn() ? request.auth.token.get('member', '') : ''; }
    function changedOnly(ks) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ks); }
    // 这一格（例如 votes）里只动到自己那一个
    function ownOnly(f) { return request.resource.data.get(f, {}).diff(resource.data.get(f, {})).affectedKeys().hasOnly([me()]); }

    // 其他没列出来的：只有最高权限能改；secrets 谁都不能看
    match /{coll}/{document=**} {
      allow read: if coll != 'secrets';
      allow write: if coll != 'secrets' && can([]);
    }

    // secrets 只给登录服务（/api/login 自己发的 svc 通行证，只有服务器钥匙发得出）读写；App 的手机谁都碰不到
    match /secrets/{id}       { allow read, write: if signedIn() && request.auth.token.get('svc', false) == true; }

    match /setlists/{id}      { allow write: if can(['admin', 'mass', 'conduct']); }
    match /custom_songs/{id}  { allow write: if can(['admin', 'mass', 'conduct']); }
    match /song_renames/{id}  { allow write: if can(['admin', 'conduct']); }
    match /song_audio/{id}    { allow write: if can(['admin', 'mass', 'conduct']); }
    match /masses/{id}        { allow write: if can(['mass', 'duties', 'seating', 'admin', 'members']); }
    match /duties/{id}        { allow write: if can(['duties', 'mass', 'members']); }
    match /seatings/{id}      { allow write: if can(['seating', 'members']); }
    match /photos/{id}        { allow write: if can(['photos']); }
    match /announcements/{id} { allow write: if can(['notice']); }
    match /prayers/{id}       { allow write: if signedIn(); }
    match /config/quiz        { allow write: if can(['quiz']); }
    match /config/attendance  { allow write: if can(['attendance']); }

    match /members/{id} {
      allow write: if can(['members', 'seating']);
      // 自己改自己：名字；改名／合并的待办（电话经登录服务换）
      allow update: if me() == id && changedOnly(['name', 'fullName', 'updatedAt', 'pendingRename', 'pendingMerge']);
    }

    match /attendance/{id} {
      allow write: if can(['attendance', 'members']);
      // 团员自己扫码签到／签退：只动自己那一格
      allow update: if me() != '' && changedOnly(['times', 'marks', 'pts', 'names', 'updatedAt'])
        && ownOnly('times') && ownOnly('marks') && ownOnly('pts') && ownOnly('names');
    }

    match /rsvp/{id} {
      allow write: if can(['attendance', 'admin']);
      // 团员按「会来／请假」：只动自己那一票
      allow create: if me() != '' && request.resource.data.keys().hasOnly(['date', 'kind', 'votes', 'names', 'updatedAt'])
        && request.resource.data.get('votes', {}).keys().hasOnly([me()]) && request.resource.data.get('names', {}).keys().hasOnly([me()]);
      allow update: if me() != '' && changedOnly(['votes', 'names', 'updatedAt'])
        && ownOnly('votes') && ownOnly('names');
    }

    match /quiz_results/{id} {
      allow create: if true;
      allow update: if changedOnly(['tap', 'tapPrev', 'tapRetakeAt']) || can(['quiz', 'members']);
      allow delete: if can(['quiz']);
    }
  }
}
